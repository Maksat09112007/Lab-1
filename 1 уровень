# Вводим два целых числа
a = int(input("Введите первое число: "))
b = int(input("Введите второе число: "))

# Вычисляем результаты
s = a + b
d = a - b
p = a * b
avg = (a + b) / 2

# Выводим результаты
print("Сумма:", s)
print("Разность:", d)
print("Произведение:", p)
print("Среднее арифметическое:", avg)
